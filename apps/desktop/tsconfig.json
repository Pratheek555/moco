{
  "compilerOptions": {
    "target": "ES2023",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noFallthroughCasesInSwitch": true,
    "types": [
      "node",
      "electron-vite/node"
    ],
    "paths": {
      "@/*": [
        "./src/renderer/src/*"
      ]
    }
  },
  "include": [
    "src",
    "electron.vite.config.ts"
  ]
}
