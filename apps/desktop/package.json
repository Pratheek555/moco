    "@moco/kit": "workspace:*",
    "@moco/renderer": "workspace:*",
    "@moco/spec": "workspace:*",
    "@remotion/bundler": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.539",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "@playwright/test": "^1.64.1"
