{
  "name": "@moco/desktop",
  "productName": "Moco",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn an idea into animated 9:16 reels, rendered locally.",
  "author": "Moco",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
