{
  "name": "@moco/desktop",
  "productName": "Moco",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn an idea into animated 9:16 reels, rendered locally.",
  "author": "Moco",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --config electron-builder.yml",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:voice-settings": "node scripts/voice-settings-test.mjs",
    "test:account-switch": "node scripts/account-switch-test.mjs",
    "test:duration-settings": "node scripts/duration-settings-test.mjs",
    "test:voice-audio": "node scripts/voice-audio-test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@moco/ai": "workspace:*",
    "@moco/audio": "workspace:*",
    "@moco/engine": "workspace:*",
    "@moco/kit": "workspace:*",
    "@moco/learn": "workspace:*",
    "@moco/renderer": "workspace:*",
    "@moco/spec": "workspace:*",
    "@remotion/bundler": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.64.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "3.8.0",
    "remotion": "4.0.539",
    "sonner": "^2.0.8",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.5"
  }
