    "sentences": [
      {
        "text": "The tornado ripped towards the stadium with thousands of fans inside.",
        "start": 0,
        "end": 4.28,
        "words": 11
      },
      {
        "text": "But as the game was about to end, one player launched the ball from the 3 -point line, which rolled into the hoop just as the clock ended.",
        "start": 4.68,
        "end": 12.82,
        "words": 28
      },
      {
        "text": "This tied the game, sending it into overtime and making the fans stay in their seats.",
        "start": 13.16,
        "end": 18.54,
        "words": 16
      },
      {
        "text": "Just minutes later, the tornado hit the building, tearing up the roof and whipping shattered glass at anyone outside.",
        "start": 18.96,
        "end": 25.84,
        "words": 19
      },
      {
        "text": "But thanks to that single shot, Watch All The Fans Were Kept Safe Inside",
        "start": 26.44,
        "end": 30.26,
        "words": 14
      }
