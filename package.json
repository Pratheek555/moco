{
  "name": "moco",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "voice:setup": "tsx scripts/setup-voice.ts",
    "voice:download": "tsx scripts/download-voice.ts",
    "voice:demo": "tsx scripts/voice-demo.ts",
    "learn:setup": "tsx scripts/setup-learn.ts",
    "learn": "tsx scripts/learn.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @moco/desktop typecheck",
    "live": "tsx scripts/live-episode.ts",
    "dev": "pnpm --filter @moco/desktop dev",
    "test:desktop": "pnpm --filter @moco/desktop test:smoke",
    "library:setup": "tsx scripts/setup-library.ts",
    "stills": "tsx scripts/stills.ts"
  },
  "devDependencies": {
    "@moco/ai": "workspace:*",
    "@moco/audio": "workspace:*",
    "@moco/engine": "workspace:*",
    "@moco/learn": "workspace:*",
    "@moco/renderer": "workspace:*",
    "@moco/spec": "workspace:*",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
