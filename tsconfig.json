{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true, // Node runs these sources directly (type stripping) in the desktop engine host
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["packages/*/src", "packages/*/test", "packages/*/bench", "packages/*/spikes", "scripts"]
}
